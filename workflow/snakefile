#-----------------------------------------------------------
# SNAKEMAKE BOILERPLATE AND IMPORTS
#-----------------------------------------------------------
from pathlib import Path
import re
import os

configfile: 'config/config.yaml'
shell.executable("/bin/zsh")

#-----------------------------------------------------------
# UTILITY / INPUT FUNCTIONS
#-----------------------------------------------------------

#-------------- Get list of directories that contain plate data ---------
PLATE_NAMES = [
    p.name
    for p in Path(config['pathvars']['plate_data']).iterdir()
    if p.is_dir()
]

# -------- Get PID of snakemake process ----------
config['PID'] = os.getpid()


#-------------- Raw Name Functions -------
# Matches something like: 't1_A01_s1_w1_z1.tif'
ImageXpress_name_regex = r't(?P<timepoint>\d*)_(?P<row>.)(?P<column>\d*)_s(?P<site>\d*)_w(?P<wavelength>\d*)_z(?P<z_stack>\d*).tif$'
ImageXpress_name_pattern = re.compile(ImageXpress_name_regex)

def extract_raw_name( well_name:str ):
    return ImageXpress_name_pattern.search(well_name).groupdict()

def generate_raw_name( groupdict, channel: int ):
    return f't{groupdict['timepoint']}_{groupdict['row']}{groupdict['column']}_s{groupdict['site']}_w{str(channel)}_z{groupdict['z_stack']}.tif'

#-------------- Standard FOV Name Functions ---------------
std_name_regex = r'(?P<row>.)(?P<column>\d*)s(?P<site>\d*)t(?P<timepoint>\d*)z(?P<z_stack>\d*)'
std_name_pattern = re.compile(std_name_regex)

def generate_std_name(groupdict):
    return f'{groupdict['row']}{groupdict['column']}s{groupdict['site']}t{groupdict['timepoint']}z{groupdict['z_stack']}'

def extract_std_name(std_name: str):
    return std_name_pattern.search(std_name).groupdict()

#-------------- Get unique FOVs given a plate name ----------------------
# Function to return all of the unique FOVs in a plate name folder using set comprehension
def get_FOVs(wildcards):
    plate_dir = config['pathvars']['plate_data'] + '/' + wildcards.plate_name
    return sorted({
        generate_std_name(extract_raw_name(str(p)))
        for p in Path(plate_dir).iterdir()        
        if ImageXpress_name_pattern.search(str(p)) != None
    })

#------------- Extract metadata from a plate name -------------------------
plate_name_regex = r'(?P<plate_number>\d*)_(?P<plate_contents>.*)_(?P<screen_name>.*)_(?P<acquisition_date>.*)_'
plate_name_pattern = re.compile(plate_name_regex)

def extract_plate_name(plate_name):
    return plate_name_pattern.search(plate_name).groupdict()

#-------------- Factory function to generate list of all images from channel ---------------
def get_channel_images(channel):
    def filenames(wildcards):
        return [
            generate_raw_name(
                groupdict = extract_std_name(name),
                channel = channel
            )
            for name in get_FOVs(wildcards)
        ]
    return filenames

#Get the image for a specific channel, assuming FOV and plate name are valid wildcards
def get_channel_image(wildcards, channel):
    return f'{config['pathvars']['plate_data']}/{wildcards.plate_name}/{
                generate_raw_name(
                    groupdict = extract_std_name(wildcards.FOV),
                    channel = channel
                )}'

#-----------------------------------------------------------
# RULE ALL: Make a unique .db file for each input plate name
#-----------------------------------------------------------
rule all:
   input:
       expand("<databases>/{plate_name}.db", plate_name=PLATE_NAMES)


#-----------------------------------------------------------
# RULE 1: Substample images on a plate to get parameters
#-----------------------------------------------------------
rule sample_images:
    input:
        plate_directory = "<plate_data>/{plate_name}",

        cellmask_images=expand(
            "<plate_data>/{{plate_name}}/{filename}",
            filename=get_channel_images(config['channels']['cellmask']),
        ),

        constitutive_images=expand(
            "<plate_data>/{{plate_name}}/{filename}",
            filename=get_channel_images(config['channels']['constitutive']),
        ),

        reporter_images=expand(
            "<plate_data>/{{plate_name}}/{filename}",
            filename=get_channel_images(config['channels']['reporter']),
        ),
    output: 
        params_file= "<results>/{plate_name}/{plate_name}.params.json"
    params:
        sample_proportion= config['sample_proportion']
    script:
        "scripts/1_sample_images.py"
        
#-----------------------------------------------------------
# RULE 2: Run Cellpose
#-----------------------------------------------------------
rule run_cellpose:
    input:
        cellmask_image= lambda wc: get_channel_image(wildcards=wc, channel = config['channels']['cellmask'])
    output:
        cellpose_mask= "<results>/{plate_name}/cellpose_masks/{FOV}_cellpose.tif"
    params:
        diameter = config['cellpose']['diameter'],
        resample = config['cellpose']['resample'],
        batch_size = config['cellpose']['batch_size'],
        min_size = config['cellpose']['min_size'],
        socket_path = config['cellpose']['socket_path'],
        server_path = f'{workflow.basedir}/scripts/2b_cellpose_server.py',
        verbose = config['cellpose']['verbose']
    resources:
        gpu= 1
    script:
        "scripts/2a_cellpose_client.py"

#-----------------------------------------------------------
# RULE 3: Process FOV
#-----------------------------------------------------------
rule process_fov:
    input:
        cellpose = "<results>/{plate_name}/cellpose_masks/{FOV}_cellpose.tif",

        cellmask = lambda wc: get_channel_image(wildcards=wc, channel = config['channels']['cellmask']),

        constitutive = lambda wc: get_channel_image(wildcards=wc, channel = config['channels']['constitutive']),

        reporter = lambda wc: get_channel_image(wildcards=wc, channel = config['channels']['reporter']),

        analysis_params = "<results>/{plate_name}/{plate_name}.params.json"

    output:
        merged_image = "<results>/{plate_name}/merged_images/{FOV}_merged.tif",
        cellpose_parquet = "<results>/{plate_name}/parquets/{FOV}_cellpose.parquet",
        constitutive_parquet = "<results>/{plate_name}/parquets/{FOV}_constitutive.parquet",
        reporter_parquet = "<results>/{plate_name}/parquets/{FOV}_reporter.parquet",
        constOverlap_parquet = "<results>/{plate_name}/parquets/{FOV}_constOverlap.parquet",
        repOverlap_parquet = "<results>/{plate_name}/parquets/{FOV}_repOverlap.parquet"

    params:
        FOV_id = "{FOV}",
        row = lambda wc: extract_std_name(wc.FOV)['row'],
        column = lambda wc: extract_std_name(wc.FOV)['column'],
        site = lambda wc: extract_std_name(wc.FOV)['site'],

    script:
        "scripts/3_process_fov.py"

#-----------------------------------------------------------
# RULE 4: Combine Parquets
#-----------------------------------------------------------

rule combine_parquets:
    input:
        cellpose_parquets = expand("<results>/{{plate_name}}/parquets/{FOV}_cellpose.parquet", FOV = get_FOVs),
        constitutive_parquets = expand("<results>/{{plate_name}}/parquets/{FOV}_constitutive.parquet", FOV = get_FOVs),
        reporter_parquets = expand("<results>/{{plate_name}}/parquets/{FOV}_reporter.parquet", FOV = get_FOVs),
        constOverlap_parquets = expand("<results>/{{plate_name}}/parquets/{FOV}_constOverlap.parquet", FOV = get_FOVs),
        repOverlap_parquets = expand("<results>/{{plate_name}}/parquets/{FOV}_repOverlap.parquet", FOV = get_FOVs),

        library_annotation_file = "<resources>/SangerLibraryAnnotations.csv",

    output:
        database_output = "<databases>/{plate_name}.db",

    params:
        represented_FOVs = lambda wc: [{'well_row': extract_std_name(FOV)['row'], 'well_column': extract_std_name(FOV)['column'], 'well_site': extract_std_name(FOV)['site']}
                                        for FOV in get_FOVs(wc)],

        plate_id = "{plate_name}",
        plate_name = "{plate_name}",
        plate_number = lambda wc: extract_plate_name(wc.plate_name)['plate_number'],
        acquisition_date = lambda wc: extract_plate_name(wc.plate_name)['acquisition_date'],

        control_virus_wells = config['control_virus_wells'],
        reporter_control_wells = config['reporter_control_wells'],
        uninfected_wells = config['uninfected_wells'],

    script:
        'scripts/4_combine_parquets.py'